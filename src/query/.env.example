# LLM Service (Granite via vLLM InferenceService)
LLM_BASE_URL=http://granite-llm-predictor.data-strat-poc.svc.cluster.local/v1
LLM_MODEL_NAME=granite-llm
LLM_API_KEY=unused

# Milvus
MILVUS_URI=http://localhost:19530

# Embedding (local sentence-transformers)
EMBEDDING_MODEL=ibm-granite/granite-embedding-125m-english

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=underwriter-chat

# Defaults
DEFAULT_COLLECTION=underwriting_guidelines
DEFAULT_TOP_K=10
